{
  "dependencies": {
    "@calcit/procs": "0.32.1",
    "@google/genai": "^1.47.0"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "vite": "8.3.5"
  },
  "version": "0.0.4",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "compile": "calcit calcit.cirru js",
    "compile:web": "calcit calcit.cirru --entry web js",
    "check:deprecated": "calcit calcit.cirru analyze weak-types --only deprecated-call --summary-only --format json",
    "test:config": "calcit --entry test-config js && node --input-type=module -e 'import(\"./js-out/genai.test-config.mjs\").then(m => m.main_$x_())'",
    "build": "yarn compile:web && vite build",
    "dev": "yarn compile:web && vite",
    "watch": "calcit calcit.cirru --entry web js -w"
  }
}
